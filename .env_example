# ===========================================================
# Text-to-SQL Engine — Environment Configuration
# ===========================================================
# Copy this file to .env and modify as needed.
# .env is git-ignored and will not be committed.
# ===========================================================

# Model configuration
TEXT2SQL_MODEL_PATH=./models/text2sql-qwen-pytorch-v1-v1/text2sql-v1
MAX_NEW_TOKENS=256

# FastAPI server
API_HOST=0.0.0.0
API_PORT=8000
RATE_LIMIT_PER_MINUTE=10/minute
RATE_LIMIT_BURST=3/10seconds

# Gradio UI
FASTAPI_URL=http://127.0.0.1:8000
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860

# Security
# RELOAD_SECRET=change-me-in-production
# CORS_ORIGINS=http://localhost:7860,http://127.0.0.1:7860